{
  "name": "valise",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "postinstall": "wrangler types && react-router typegen && npm run css:build",
    "css:build": "tailwindcss -i styles/valise.css -o public/valise.css --minify",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-lock.mjs \"npm run verify:ci && npm run test:ui\"",
    "verify:ci": "node scripts/run-stages.mjs css:build lint+typecheck+db:audit test:d1+test:mcp test:clients",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote --config ${VALISE_CONFIG:-wrangler.jsonc}",
    "db:audit": "node scripts/migrations.mjs audit && ./scripts/probe-migration-gate.sh",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/run-stages.mjs css:build build:bundle",
    "build:bundle": "react-router build",
    "preview": "npm run build && vite preview",
    "typegen": "react-router typegen",
    "seed": "node scripts/dev-seed.mjs",
    "reindex": "node scripts/reindex.mjs",
    "evals": "node evals/run.mjs",
    "evals:index": "node evals/index.mjs",
    "evals:verdict": "node evals/verdict.mjs",
    "evals:store": "rm -rf .wrangler/evals && wrangler d1 migrations apply DB --local --persist-to .wrangler/evals",
    "shots": "node scripts/console-shots.mjs",
    "shots:extension": "node scripts/extension-shots.mjs",
    "shots:ui": "npm run css:build && node scripts/ui-consistency-shots.mjs",
    "shots:readme": "npm run css:build && node scripts/readme-gif.mjs",
    "oauth:roundtrip": "node scripts/oauth-roundtrip.mjs",
    "test:d1": "vitest run --config vitest.d1.config.ts",
    "test:mcp": "vitest run --config vitest.mcp.config.ts",
    "test:clients": "node --test test/ui-server.test.mjs test/self-host.test.mjs test/deploy-head.test.mjs test/backup.test.mjs test/raindrop.test.mjs test/build-stages.test.mjs test/verify-lock.test.mjs test/recovery-drill.test.mjs test/evals/writeback.test.mjs test/evals/memory-review-context.test.mjs test/worktrees.test.mjs test/prod-read.test.mjs test/dev-setup.test.mjs && vitest run --config vitest.clients.config.ts",
    "test:ui": "playwright test",
    "cf-typegen": "wrangler types && react-router typegen",
    "evals:trends": "node evals/trends.mjs",
    "cli:install": "npm install -g --install-links ./clients/valise-cli",
    "worktrees": "node scripts/worktrees.mjs list"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@modelcontextprotocol/server": "^2.0.0",
    "agents": "^0.28.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.58.0",
    "pdfjs-dist": "^6.4.299",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "^4.0.1",
    "resend": "^6.34.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@modelcontextprotocol/client": "2.0.0",
    "@mozilla/readability": "0.6.0",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "defuddle": "0.19.5",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  }
}
