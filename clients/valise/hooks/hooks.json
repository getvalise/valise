{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/valise-hook.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:valise:valise",
            "tool": "get_brief",
            "input": { "cwd": "${cwd}", "hook": "SessionStart" },
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/valise-hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:valise:valise",
            "tool": "search",
            "input": {
              "query": "${error}",
              "hook": "PostToolUseFailure",
              "session_id": "${session_id}"
            },
            "timeout": 10
          }
        ]
      }
    ]
  }
}
